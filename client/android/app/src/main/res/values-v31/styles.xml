<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 的系统启动屏：暖黑底上的琥珀圆底光圈，和 Flutter 开机动画的第一帧
         一模一样（大小、位置都对得上），首帧画出来时看不出切换（lib/app/launch_splash.dart） -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
