# 复制为 .env 后填写。.env 不进仓库。

# 应用密钥：签名登录、播放和插件页面令牌。至少 32 个字符，生成方式：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 更换后所有登录和播放令牌失效，需要重新登录；插件自己的凭据由插件保存。
APP_SECRET_KEY=

# 首个管理员，只在数据库里还没有管理员时创建
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

APP_HTTP_PORT=8080

# 插件根目录；不填时开发环境默认用仓库根目录的 plugins/，镜像里由 Dockerfile 设为 /app/plugins
# APP_PLUGINS_DIR=

# 定时同步的时间点按这个时区解释，填 IANA 时区名
TZ=Asia/Shanghai

# 单独部署 Web 客户端（不由本服务托管）时，列出允许跨域访问的来源，逗号分隔，例如
#   https://web.example.com,http://192.168.1.10:3000
# 留空表示不开放跨域；App 和由本服务托管的 Web 页面都不需要（ADR 0017）
APP_CORS_ORIGINS=
