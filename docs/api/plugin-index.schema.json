{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huhengbo.github.io/iris-plugins/schema/index.v1.schema.json",
  "title": "Iris 插件仓库索引（schema 1）",
  "description": "插件仓库的 index.json。宿主只认 schema 1；条目逐条校验，不合格的跳过并计入 invalid_count。未知字段会被忽略。",
  "type": "object",
  "required": ["schema", "name", "plugins"],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "仓库名称，显示在管理后台的仓库列表和目录里。"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "索引生成时间，RFC 3339。"
    },
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "sdk",
        "provides",
        "capabilities",
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "not": {
            "pattern": "^builtin\\."
          },
          "description": "插件 id；builtin. 前缀保留给随镜像发布的系统插件。"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){0,3}$",
          "description": "点分数字版本；同一个 id 可以有多个版本。"
        },
        "sdk": {
          "type": "string",
          "description": "插件的 SDK 兼容范围，例如 >=1.0,<2.0。"
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "插件 zip 的绝对地址，或相对于 index.json 的地址。必须是 HTTPS；本机开发可用 localhost 的 HTTP。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "插件 zip 的 sha256，小写十六进制。"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800,
          "description": "插件 zip 的字节数，最大 50 MiB。"
        },
        "homepage": {
          "type": ["string", "null"],
          "description": "插件主页，可为空。"
        },
        "signature": {
          "description": "预留的签名字段；宿主当前只透传，不校验。"
        }
      },
      "additionalProperties": true
    }
  }
}
